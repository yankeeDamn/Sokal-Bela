# Firebase configuration template

# The following variables are used for Firebase configuration. Please update them with actual values, but remember not to commit sensitive information to the repository.

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id_here

# Razorpay payment gateway credentials
# Get these from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for development/staging and rzp_live_* for production.
# NEVER commit real values — the secret must only exist on the server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook secret for POST /api/razorpay-webhook (production Cloud Functions).
# Set the same value in Razorpay Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Environment variables that should not be committed
EXAMPLE_SECRET_KEY=your_secret_key_here
EXAMPLE_OTHER_SENSITIVE_VAR=your_other_sensitive_value
