# ===== POSTGRESQL REBUILD (Phase 2 Preview; names only) =====
# Connect to a separate Neon development branch, not the production database.
DATABASE_URL=
# For Phase 5 admin authentication (not used in Phase 2).
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Public Firebase project configuration (Firebase web API key is public).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Server-only: JSON serialized Firebase service account, kept in Vercel Environment Variables.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server-only: secret HMAC key at least 32 unpredictable characters.
OTP_HASH_SECRET=

# Real email delivery (Resend verified sender/domain).
RESEND_API_KEY=
EMAIL_FROM=

# Comma-separated administrator email allowlist (server-only).
ADMIN_EMAILS=

# Optional legacy payment integration. Online checkout is currently disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
