{
  "functions": { "source": "backend/functions" },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "backend/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "asia-south1" } },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/admin/**", "destination": "/admin.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8081 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
