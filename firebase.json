{
  "functions": {
    "source": "backend/functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "predeploy": ["npm run build"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "api/**",
      "scripts/**",
      "*.zip",
      "*.md",
      "*.rules",
      "package.json",
      "package-lock.json",
      "local-server.js",
      "build.js",
      "vercel.json",
      "admin.html",
      "admin.js",
      "app.js",
      "lib/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8081
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
