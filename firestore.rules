rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: public read, admin write only
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "yankeecpp90@gmail.com";
    }

    // Orders: public create (customers placing orders), admin read/write
    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == "yankeecpp90@gmail.com";

      // Order items: public create alongside the order, admin read
      match /items/{itemId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null && request.auth.token.email == "yankeecpp90@gmail.com";
      }
    }

    // Admin notifications: public create (order alerts), admin read/write
    match /adminNotifications/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == "yankeecpp90@gmail.com";
    }

    // Bulk Orders: public create, admin read/write
    match /bulkOrders/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == "yankeecpp90@gmail.com";
    }

    // Payments: written only by the backend (Admin SDK bypasses rules after
    // server-side signature verification). Admin can read for reconciliation.
    match /payments/{id} {
      allow read: if request.auth != null && request.auth.token.email == "yankeecpp90@gmail.com";
      allow write: if false;
    }
  }
}
